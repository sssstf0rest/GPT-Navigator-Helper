{
  "manifest_version": 3,
  "name": "Native Navigator Helper for ChatGPT",
  "version": "0.4.0",
  "description": "Automatically prepare ChatGPT’s native navigator while preserving your reading position, with pause and manual controls.",
  "minimum_chrome_version": "111",
  "action": {
    "default_title": "Native Navigator Helper",
    "default_popup": "src/popup/index.html"
  },
  "content_scripts": [
    {
      "js": [
        "src/native/pageHook.iife.js"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "js": [
        "assets/content.ts-loader-byqBL8rW.js"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "resources": [
        "assets/panelState-CBmkUnyT.js",
        "assets/content.ts-vRk-0tvB.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
